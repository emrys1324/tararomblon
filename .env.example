# Copy these into Vercel > Project > Settings > Environment Variables (Production), then redeploy.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: server only, never put it in the HTML

# The 2 MJV Services OPC Super Admins (comma separated). Used only until the first Super Admin exists.
SUPER_ADMINS=owner@example.com,manager@example.com

# Your live site, e.g. https://tararomblon.vercel.app or your own domain
SITE_URL=https://tararomblon.vercel.app
# Optional extra inbox that gets every Super Admin email
NOTIFY_EMAIL=

# Email (resend.com > API Keys). MAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
MAIL_FROM=bookings@yourdomain.ph

# HitPay > Settings > Payment Gateway > API Keys
HITPAY_API_KEY=
# HitPay > Developers > Webhook Endpoints > your endpoint's salt
HITPAY_SALT=
# true while testing with the sandbox, false when live
HITPAY_SANDBOX=true

# Optional: Loyverse personal access token for Pahuway Café reward points (Loyverse Back Office > Access tokens).
# The Merchant Admin can also paste it in Merchant app > Store settings > Rewards.
LOYVERSE_TOKEN=

# Optional: Google Maps for live rider tracking. Create a browser key in Google Cloud (Maps JavaScript API enabled),
# restrict it to your site (HTTP referrers), and optionally a Map ID. Without a key the apps use OpenStreetMap.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Optional: "Continue with Google" on the customer sign-in / sign-up screens. Google Cloud > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application; add your site under "Authorized JavaScript origins".
# This is the public Client ID (ends in .apps.googleusercontent.com), not the client secret.
GOOGLE_CLIENT_ID=

# Any long random string; Vercel uses it to call the daily /api/cron
CRON_SECRET=
